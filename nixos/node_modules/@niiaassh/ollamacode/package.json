{
  "name": "@niiaassh/ollamacode",
  "version": "0.0.9",
  "description": "An open-source AI agent that brings the power of ollamacode directly into your terminal.",
  "main": "dist/index.js",
  "bin": {
    "ollamacode": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "agent",
    "text-editor",
    "ai"
  ],
  "author": "niiaassh",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^0.3.68",
    "@langchain/ollama": "^0.2.3",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "ai": "^5.0.5",
    "axios": "^1.6.0",
    "cfonts": "^3.3.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^16.3.0",
    "enquirer": "^2.4.1",
    "fs-extra": "^11.1.1",
    "ink": "^3.2.0",
    "ink-markdown": "^1.0.4",
    "ollama-ai-provider": "^1.2.0",
    "openai": "^5.10.1",
    "react": "^17.0.2",
    "ripgrep-node": "^1.0.0",
    "tiktoken": "^1.0.21"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.2",
    "@types/ink": "^0.5.2",
    "@types/node": "^20.8.0",
    "@types/react": "^17.0.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "eslint": "^9.31.0",
    "nodemon": "^3.1.10",
    "tsx": "^4.0.0",
    "typescript": "5.5"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "preferGlobal": true
}
